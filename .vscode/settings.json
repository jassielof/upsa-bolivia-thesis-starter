{
    "[typst]": {
        "editor.wordWrap": "bounded",
        "editor.wordWrapColumn": 100,
        "editor.wrappingIndent": "indent"
    },
    "ltex.language": "es-AR",
    "tinymist.fontPaths": [
        "${workspaceFolder}/assets/fonts"
    ],
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.typ": "${capture}.pdf, ${capture}-*.pdf, ${capture}.typ",
        "*-PLAN.typ": "${capture}*.pdf",
    },
    "yaml.schemas": {
        "https://typst-community.github.io/json-schemas/docs/hayagriva.schema.json": [
            "**/*.{hay,haya,hayagriva}",
            "**/*.{hay,haya,hayagriva}.{yml,yaml}",
        ]
    }
}
